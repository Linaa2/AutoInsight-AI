# LLM Provider — "ollama" (default, local) or "gemini"
LLM_PROVIDER=ollama

# LLM Primaire — Google Gemini (gratuit)
# Clé dispo sur : https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# LLM Fallback — Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
LLM_TIMEOUT=60

# Profiler settings
PROFILER_SAMPLE_ROWS=5
PROFILER_TOP_VALUES=10

# Data loader settings
DATA_LOADER_EXCEL_SHEET=0

# Streamlit app settings
APP_TITLE=AutoInsight AI

# Optional: override path to prompts YAML
# PROMPTS_PATH=config/prompts.yaml

# Evaluation (P7) settings
# Judge model: use qwen3:14b (text reasoning) rather than coder model
EVAL_JUDGE_MODEL=qwen3:14b
# Context window: max chars kept per markdown section / per insight text field
EVAL_MAX_SECTION_CHARS=300
EVAL_MAX_INSIGHT_FIELD_CHARS=150
# Grade thresholds (0.0 - 1.0): scores above each threshold earn that grade
EVAL_EXCELLENT_THRESHOLD=0.85
EVAL_GOOD_THRESHOLD=0.70
EVAL_FAIR_THRESHOLD=0.50

# LangFuse — monitoring (gratuit)
# Compte sur : https://langfuse.com
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# ChromaDB — mémoire vectorielle (local)
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=autoinsight_memory
