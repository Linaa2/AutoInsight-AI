# ===========================================================================
# AutoInsight-AI — Environment Variables
# ===========================================================================
# Copy this file to .env and fill in your values.
# Only TRUE RUNTIME settings belong here. Static project paths (prompts file,
# docs directory) are managed in config/settings.py — do NOT add them here.
# ===========================================================================

# LLM provider: "ollama" (default, local) or "gemini" (cloud)
LLM_PROVIDER=gemini

# Google Gemini (when LLM_PROVIDER=gemini)
# Get a key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=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
GEMINI_MODEL=gemini-1.5-flash

# Ollama — local inference (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen3:14b
OLLAMA_CODE_MODEL=qwen2.5-coder:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT=60

# Profiler settings
PROFILER_SAMPLE_ROWS=5
PROFILER_TOP_VALUES=10
# LLM context detail level: "fast" (default, compact) or "full" (extended per-column stats)
PROFILER_DETAIL_MODE=fast

# Data loader settings
DATA_LOADER_EXCEL_SHEET=0

# Streamlit app settings
APP_TITLE=AutoInsight AI

# LangFuse — external observability (optional)
# ──────────────────────────────────────────────────────────────────────────
# AUTOMATED SETUP (recommended):
#   Run `make langfuse-up` — it generates all credentials automatically,
#   writes .env.langfuse for Docker Compose, and updates this .env file.
#   No manual account creation or key copying needed.
#
# MANUAL SETUP (cloud or existing server):
#   Set the four vars below and set LANGFUSE_ENABLED=true.
#   Cloud: https://cloud.langfuse.com
# ──────────────────────────────────────────────────────────────────────────
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:3001
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_ENV=development
LANGFUSE_RELEASE=

# ChromaDB — vector memory (local)
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=autoinsight_memory

# Uncertainty Estimator (Phase 8)
# Confidence level thresholds (integer 0-100)
EVAL_UNCERTAINTY_HIGH_THRESHOLD=80
EVAL_UNCERTAINTY_MEDIUM_THRESHOLD=50

# LLM-as-Judge (Phase 10)
# Model used for evaluation (defaults to OLLAMA_TEXT_MODEL when unset)
EVAL_JUDGE_MODEL=
# Maximum characters per ## section before truncation (integer)
EVAL_MAX_SECTION_CHARS=300
# Maximum characters per insight field before truncation (integer)
EVAL_MAX_INSIGHT_FIELD_CHARS=150
# Grade thresholds (float 0.0–1.0)
EVAL_EXCELLENT_THRESHOLD=0.85
EVAL_GOOD_THRESHOLD=0.70
EVAL_FAIR_THRESHOLD=0.50
