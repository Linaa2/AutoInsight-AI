# LLM Primaire — Google Gemini (gratuit)
# Clé dispo sur : https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# LLM Fallback — Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
LLM_TIMEOUT=15

# LangFuse — monitoring (gratuit)
# Compte sur : https://langfuse.com
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# ChromaDB — mémoire vectorielle (local)
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=autoinsight_memory